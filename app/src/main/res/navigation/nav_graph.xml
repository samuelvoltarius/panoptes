<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/panoptesStartFragment">

    <!-- 0.1.7.1 (Alfreds Test „sieht aus wie OverDrive“): EINE Oberfläche. Die App startet vollflächig in
         der Panoptes-Web-Oberfläche (lokal 8180, automatische Anmeldung); Navigation in der Web-Oberfläche.
         -->
    <!-- 0.1.39 A1: die alte native Oberfläche (Dashboard, Aufnahmen-Liste, Player, Einstellungen, Leiste …) ist gelöscht.
         Es bleiben das Web-Startziel und die Funktionsflächen Projektion und BYD-Cloud-Anmeldung. -->
    <fragment
        android:id="@+id/panoptesStartFragment"
        android:name="at.greenchili.surfmate.ui.fragment.WebViewFragment"
        android:label="@string/app_name"
        tools:layout="@layout/fragment_webview">
        <argument
            android:name="page_path"
            app:argType="string"
            android:defaultValue="/" />
        <argument
            android:name="vollbild"
            app:argType="boolean"
            android:defaultValue="true" />
    </fragment>

    <fragment
        android:id="@+id/projectionFragment"
        android:name="at.greenchili.surfmate.ui.fragment.ProjectionFragment"
        android:label="@string/rail_projection"
        tools:layout="@layout/fragment_projection" />

    <fragment
        android:id="@+id/bydCloudFragment"
        android:name="at.greenchili.surfmate.ui.fragment.WebViewFragment"
        android:label="@string/nav_page_byd_cloud"
        tools:layout="@layout/fragment_webview">
        <argument
            android:name="page_path"
            app:argType="string"
            android:defaultValue="/byd-cloud" />
    </fragment>
</navigation>
