    <string name="einr_autostart_spaeter">Lo faccio più tardi</string>
    <string name="einr_usb_titel">Autorizzazione per Panoptes (debug USB)</string>
    <string name="einr_usb_warum">Perché Panoptes possa continuare a funzionare in background e ripararsi da solo, serve un’autorizzazione una tantum.</string>
    <string name="einr_usb_popup">Android mostrerà ora una finestra: «Consentire il debug USB?». Spunta «Consenti sempre da questo computer» e tocca «Consenti».</string>
    <string name="einr_usb_knopf">Richiedi autorizzazione</string>
    <string name="einr_usb_popup_jetzt">Nella finestra di Android spunta «Consenti sempre» e tocca «Consenti».</string>
    <string name="einr_usb_warte">In attesa dell’autorizzazione …</string>
    <string name="einr_usb_ok">Autorizzazione concessa, Panoptes è in esecuzione.</string>
    <string name="einr_auto_titel">La tua auto può …</string>
    <string name="einr_auto_unbekannt">Panoptes non ha ancora potuto verificare cosa può fare la tua auto. Lo farà più tardi.</string>
    <string name="einr_auto_ausblenden">Ciò che la tua auto non può fare, lo nascondiamo.</string>
    <string name="einr_auto_modell">Che auto guidi?</string>
    <string name="einr_auto_waehlen">Scegli modello e batteria</string>
    <string name="einr_auto_gewaehlt">Modello salvato.</string>
    <string name="einr_auto_weiss_nicht_satz">Nessun problema. Panoptes stima i valori finché non scegli il modello.</string>
    <string name="einr_f_kameras">Telecamere</string>
    <string name="einr_f_kameras_n" formatted="true">Telecamere (%1$d)</string>
    <string name="einr_kameras_titel">Assegna telecamere</string>
    <string name="einr_kameras_text">Panoptes ti mostra le immagini delle telecamere. Tocca quale immagine è anteriore, posteriore, sinistra e destra.</string>
    <string name="einr_kameras_knopf">Assegna telecamere</string>
    <string name="einr_kameras_ok">Telecamere salvate.</string>
    <string name="einr_kameras_nicht">Non ancora assegnate.</string>
    <string name="einr_betrieb_titel">Quando deve funzionare Panoptes?</string>
    <string name="einr_betrieb_text">«Sempre attivo» consuma un po’ di energia dalla batteria e dalla batteria da 12 V a veicolo fermo. Panoptes si ferma da solo prima che il livello diventi troppo basso.</string>
    <string name="einr_betrieb_immer">Sempre attivo</string>
    <string name="einr_betrieb_immer_satz">Anche da parcheggiata – necessario per il Guardiano.</string>
    <string name="einr_betrieb_fahrt">Solo durante la guida</string>
    <string name="einr_betrieb_fahrt_satz">Risparmia energia, ma niente Guardiano da parcheggiata.</string>
    <string name="einr_betrieb_empfehlung">Consigliato se usi il Guardiano: Sempre attivo.</string>
    <string name="einr_betrieb_anpassen">Puoi cambiarlo più avanti in Guardiano → «Il Guardiano si ferma quando …».</string>
    <string name="einr_stopp_akku" formatted="true">Batteria sotto %1$s%%</string>
    <string name="einr_stopp_12v" formatted="true">Batteria da 12 V sotto %1$s V</string>
    <string name="einr_stopp_stunden" formatted="true">dopo %1$s ore di sosta</string>
    <string name="einr_karte_internet">La mappa richiede internet.</string>
    <string name="einr_daten_titel">Condivisione dati</string>
    <string name="einr_daten_text">Tutto è disattivato. Attiva solo ciò che vuoi condividere – puoi disattivarlo quando vuoi in Sistema → Condivisione dati.</string>
    <string name="einr_daten_keine">Panoptes non conosce ancora opzioni di condivisione dati qui.</string>
    <string name="einr_blitzer_aus">Lascia disattivato</string>
    <string name="einr_blitzer_an">Letto – attiva</string>
    <string name="einr_updates_frage_pruefen">Panoptes deve cercare gli aggiornamenti?</string>
    <string name="einr_updates_pruefen_nein">Cerchi tu stesso in Sistema → Aggiornamenti app.</string>
    <string name="einr_extra_telegram_titel">Telegram</string>
    <string name="einr_extra_telegram_text">Messaggi dalla Sentinella e dall\'auto sul telefono, tramite il tuo bot Telegram. Funziona via Internet, senza programmi in più.</string>
    <string name="einr_extra_planer_titel">Collega il pianificatore di percorso</string>
    <string name="einr_extra_planer_text">Così vedi in viaggio se la batteria basta fino a destinazione. Il collegamento avviene con un codice sul telefono.</string>
    <string name="einr_extra_cockpit_titel">Associa l’EV Cockpit</string>
    <string name="einr_extra_cockpit_text">L’EV Cockpit sul PC mostra i valori della tua auto. L’associazione richiede un solo tocco.</string>
    <string name="einr_extra_fernzugang_titel">Accesso remoto (Tailscale)</string>
    <string name="einr_extra_fernzugang_text">Accesso diretto all\'auto tramite la tua rete Tailscale (serve un account gratuito). Serve solo per: l\'interfaccia web su PC da remoto, immagine dal vivo e video in piena qualità, manutenzione remota (adb) e accesso di emergenza. Per l\'app sul telefono basta «Collega il telefono».</string>
    <string name="einr_fertig_titel">Funziona tutto?</string>
    <string name="einr_fertig_pruefe">Panoptes sta controllando …</string>
    <string name="einr_ungeprueft">Non ancora verificato.</string>
    <string name="einr_st_ok">OK</string>
    <string name="einr_st_fehlt">mancante</string>
    <string name="einr_st_entfaellt">non pertinente</string>
    <string name="einr_st_ungeprueft">non ancora verificato</string>
    <string name="einr_fertig_knopf">Concludi</string>
    <string name="einr_fertig_schliessen">Chiudi senza tour</string>
    <string name="einr_rundgang_frage">Un breve tour di Panoptes?</string>
    <string name="einr_rundgang_ja">Sì, mostrami Panoptes</string>
    <string name="einr_extra_notzugang_titel">Accesso di emergenza per la manutenzione</string>
    <string name="einr_extra_notzugang_text">Una seconda via separata nell’auto per la manutenzione, nel caso in cui l’accesso remoto normale smetta di funzionare. Passa dalla tua rete Tailscale: solo i dispositivi del tuo tailnet possono raggiungerla, e solo per la manutenzione, non l’interfaccia di Panoptes. Spento per impostazione predefinita. Puoi spegnerlo in qualsiasi momento in Sistema → Accesso di emergenza.</string>
    <!-- 0.1.22 Gewohnheiten (GEWOHNHEITEN_KONZEPT §2, Regel 2) -->
    <string name="einr_gewohnheiten_titel">Ricordare le abitudini?</string>
    <string name="einr_gewohnheiten_text">Panoptes nota ciò che fai spesso allo stesso modo, es. preriscaldare ogni mattina, e ti chiede se d’ora in poi deve farlo da solo. Resta solo nell’auto. Puoi spegnerlo o cancellare tutto in qualsiasi momento in Sistema.</string>
    <string name="einr_gewohnheiten_ja">Sì, ricorda</string>
    <string name="einr_gewohnheiten_nein">No</string>
    <string name="einr_fortgeschritten">Per utenti esperti. Non ti serve se usi solo l\'app sul telefono.</string>
    <string name="einr_extra_handy_titel">Collega il telefono</string>
    <string name="einr_handy_zustimmung">Voglio collegare il mio telefono via Internet. Per questo il traffico cifrato passa dal nostro server in Germania. Il server non vede i dati del veicolo.</string>
    <string name="einr_handy_datenschutz">Privacy: byd.serveone.at/en/datenschutz</string>
    <string name="einr_handy_fehler">Non ha funzionato. Forse manca il segnale. Riprova più tardi.</string>
    <string name="einr_freigaben_titel">Consenti a Panoptes</string>
    <string name="einr_freigaben_text">Panoptes ne ha bisogno per funzionare da solo.</string>
    <string name="einr_freigabe_autostart">Si avvia da solo</string>
    <string name="einr_freigabe_anzeige">Avvisi sopra le altre app</string>
    <string name="einr_freigabe_rechte">Fotocamera, posizione, memoria</string>
    <string name="einr_freigabe_knopf">Consenti</string>
    <string name="einr_handy_kurz">Scansiona un codice con il telefono. Così vedi la tua auto sul telefono, anche in viaggio.</string>
    <string name="einr_handy_qr_knopf">Mostra codice QR</string>
    <string name="einr_handy_s1">Apri l’app Panoptes sul telefono.</string>
    <string name="einr_handy_s2">Tocca «Auto koppeln» (associa auto).</string>
    <string name="einr_handy_s3">Punta il telefono su questo codice.</string>
    <string name="einr_handy_keine_app">Non hai ancora l’app? Tocca «Più tardi». Panoptes funziona anche senza.</string>
    <string name="einr_handy_verbunden">Telefono collegato.</string>
    <string name="einr_noch_titel">Ancora da configurare</string>
    <string name="einr_noch_text">Tutto facoltativo. Si può fare in qualsiasi momento.</string>
    <string name="einr_noch_knopf">Configura</string>
    <string name="einr_updates_ja_knopf">Sì, cerca aggiornamenti</string>
    <string name="einr_updates_github">Panoptes chiede regolarmente a GitHub se c’è una nuova versione. GitHub vede solo l’indirizzo Internet dell’auto, nessun dato del veicolo.</string>
