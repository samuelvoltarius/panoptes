    <string name="einr_sprache_titel">Lingua</string>
    <string name="einr_sprache_text">Quale lingua deve usare Panoptes?</string>
    <string name="einr_autostart_titel">Avvia Panoptes all’accensione dell’auto</string>
    <string name="einr_autostart_text">Perché Panoptes parta da solo a ogni accensione, serve una spunta nella gestione app di BYD. BYD la toglie dopo ogni aggiornamento dell’auto. Panoptes te lo ricorderà.</string>
    <string name="einr_autostart_anleitung">Come fare: tocca «Apri impostazioni». Panoptes prova a mettere la spunta da solo. Se non funziona, cerca «Panoptes» nell’elenco e attiva l’avvio automatico. Poi torna qui.</string>
    <string name="einr_autostart_knopf">Apri impostazioni</string>
    <string name="einr_autostart_ok">L’avvio automatico è attivo.</string>
    <string name="einr_autostart_fehlt">L’avvio automatico è ancora disattivato.</string>
    <string name="einr_autostart_spaeter">Lo faccio più tardi</string>
    <string name="einr_ueberlagerung_titel">Mostra sopra altre app</string>
    <string name="einr_ueberlagerung_text">Perché Panoptes possa mostrare avvisi (ad es. una sosta di ricarica) sopra la navigazione, serve il permesso «Mostra sopra altre app».</string>
    <string name="einr_rechte_titel">Cos’altro può fare Panoptes</string>
    <string name="einr_rechte_text">Panoptes ha ricevuto questi permessi. Se ne manca uno, la funzione corrispondente non funziona.</string>
    <string name="einr_recht_kamera">Telecamera – per il Guardiano</string>
    <string name="einr_recht_standort">Posizione – per la mappa, il controllo del paese degli autovelox e le stazioni di ricarica</string>
    <string name="einr_recht_speicher">Memoria – per le registrazioni</string>
    <string name="einr_usb_titel">Autorizzazione per Panoptes (debug USB)</string>
    <string name="einr_usb_warum">Perché Panoptes possa continuare a funzionare in background e ripararsi da solo, serve un’autorizzazione una tantum.</string>
    <string name="einr_usb_popup">Android mostrerà ora una finestra: «Consentire il debug USB?». Spunta «Consenti sempre da questo computer» e tocca «Consenti».</string>
    <string name="einr_usb_knopf">Richiedi autorizzazione</string>
    <string name="einr_usb_popup_jetzt">Nella finestra di Android spunta «Consenti sempre» e tocca «Consenti».</string>
    <string name="einr_usb_warte">In attesa dell’autorizzazione …</string>
    <string name="einr_usb_ok">Autorizzazione concessa, Panoptes è in esecuzione.</string>
    <string name="einr_auto_titel">La tua auto può …</string>
    <string name="einr_auto_unbekannt">Panoptes non ha ancora potuto verificare cosa può fare la tua auto. Lo farà più tardi.</string>
    <string name="einr_auto_ausblenden">Ciò che la tua auto non può fare, lo nascondiamo.</string>
    <string name="einr_auto_modell">Che auto guidi?</string>
    <string name="einr_auto_waehlen">Scegli modello e batteria</string>
    <string name="einr_auto_gewaehlt">Modello salvato.</string>
    <string name="einr_auto_weiss_nicht_satz">Nessun problema. Panoptes stima i valori finché non scegli il modello.</string>
