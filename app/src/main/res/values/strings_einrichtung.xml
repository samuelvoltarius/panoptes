    <string name="einr_updates_titel">Updates</string>
    <string name="einr_updates_frage_pruefen">Should Panoptes look for updates?</string>
    <string name="einr_updates_pruefen_ja">Panoptes regularly checks whether there is a new version.</string>
    <string name="einr_updates_pruefen_nein">You check yourself under System → App updates.</string>
    <string name="einr_updates_frage_mobil">Also download over mobile data? This uses data volume.</string>
    <string name="einr_updates_mobil_ja">Updates also arrive on the road.</string>
    <string name="einr_updates_mobil_nein">Only over Wi-Fi.</string>
    <string name="einr_updates_frage_modus">How should updates be installed?</string>
    <string name="einr_updates_melden">Confirm myself</string>
    <string name="einr_updates_melden_satz">Panoptes reports a new version, you install it.</string>
    <string name="einr_updates_auto">Automatically</string>
    <string name="einr_updates_auto_satz">Only when the car is parked and switched off.</string>
    <string name="einr_extra_telegram_titel">Telegram</string>
    <string name="einr_extra_telegram_text">Messages from the Guardian and the car to your phone, via your own Telegram bot.</string>
    <string name="einr_extra_planer_titel">Connect the route planner</string>
    <string name="einr_extra_planer_text">Then you see on the road whether the battery lasts to your destination. You connect with a code on your phone.</string>
    <string name="einr_extra_cockpit_titel">Pair the EV Cockpit</string>
    <string name="einr_extra_cockpit_text">The EV Cockpit on your PC shows your car’s values. Pairing takes one tap.</string>
    <string name="einr_extra_fernzugang_titel">Remote access (Tailscale)</string>
    <string name="einr_extra_fernzugang_text">Only needed if you want to look into the car from elsewhere. For this you need a free Tailscale account.</string>
