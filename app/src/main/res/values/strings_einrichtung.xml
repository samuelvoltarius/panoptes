    <string name="einr_fertig_schliessen">Close without tour</string>
    <string name="einr_rundgang_frage">Short tour of Panoptes?</string>
    <string name="einr_rundgang_ja">Yes, show me Panoptes</string>
    <string name="einr_extra_notzugang_titel">Emergency access for remote maintenance</string>
    <string name="einr_extra_notzugang_text">A second, separate way into the car for maintenance, in case the normal remote access ever stops working. It runs through your own Tailscale network: only devices in your tailnet can reach it, and only for maintenance, not the Panoptes interface. Off by default. You can switch it off at any time under System → Emergency access.</string>
    <!-- 0.1.22 Gewohnheiten (GEWOHNHEITEN_KONZEPT §2, Regel 2) -->
    <string name="einr_gewohnheiten_titel">Remember habits?</string>
    <string name="einr_gewohnheiten_text">Panoptes notices what you often do the same way, e.g. preheating every morning, and asks whether it should do it for you in future. It stays only in the car. You can switch it off or delete everything at any time under System.</string>
    <string name="einr_gewohnheiten_ja">Yes, remember</string>
    <string name="einr_gewohnheiten_nein">No</string>
    <string name="einr_fortgeschritten">For advanced users. You don\'t need this if you only use the phone app.</string>
    <string name="einr_extra_handy_titel">Connect your phone</string>
    <string name="einr_handy_zustimmung">I want to connect my phone over the internet. For this, encrypted traffic runs through our server in Germany. The server does not see any vehicle data.</string>
    <string name="einr_handy_datenschutz">Privacy: byd.serveone.at/en/datenschutz</string>
    <string name="einr_handy_fehler">That didn\'t work. Maybe no signal. Please try again later.</string>
    <string name="einr_freigaben_titel">Allow Panoptes</string>
    <string name="einr_freigaben_text">Panoptes needs these three things to run by itself.</string>
    <string name="einr_freigabe_autostart">Starts by itself</string>
    <string name="einr_freigabe_anzeige">Hints over other apps</string>
    <string name="einr_freigabe_rechte">Camera, location, storage</string>
    <string name="einr_freigabe_knopf">Allow</string>
    <string name="einr_handy_kurz">Scan a code with your phone. Then you can see your car on your phone, also on the road.</string>
    <string name="einr_handy_qr_knopf">Show QR code</string>
    <string name="einr_handy_s1">Open the Panoptes app on your phone.</string>
    <string name="einr_handy_s2">Tap “Auto koppeln” (pair car).</string>
    <string name="einr_handy_s3">Point the phone at this code.</string>
    <string name="einr_handy_keine_app">No app yet? Tap “Later”. Panoptes also works without it.</string>
    <string name="einr_handy_verbunden">Phone connected.</string>
    <string name="einr_noch_titel">Still to set up</string>
    <string name="einr_noch_text">All optional. You can do this any time.</string>
    <string name="einr_noch_knopf">Set up</string>
    <string name="einr_updates_ja_knopf">Yes, look for updates</string>
    <string name="einr_updates_github">Panoptes regularly asks GitHub if there is a new version. GitHub only sees the car\'s internet address, no car data.</string>
