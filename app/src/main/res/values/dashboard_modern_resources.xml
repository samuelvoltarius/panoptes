    <dimen name="dashboard_modern_metric_gap">12dp</dimen>
    <dimen name="dashboard_modern_qr_size">184dp</dimen>

    <!-- Hero-card split: the metrics column against the vehicle render beside
         it. Both fragment_dashboard variants apply the pair twice — once to the
         render row, once to the content row — and they have to agree or the
         metrics run under the car. -->
    <item name="dashboard_hero_body_weight" format="float" type="dimen">60</item>
    <item name="dashboard_hero_art_weight" format="float" type="dimen">40</item>

    <!-- Ribbon's share of the same split. Wider than the render column so the
         line work still sweeps in behind the car. -->
    <item name="dashboard_hero_ribbon_body_weight" format="float" type="dimen">45</item>
    <item name="dashboard_hero_ribbon_art_weight" format="float" type="dimen">55</item>

    <dimen name="dashboard_hero_ribbon_portrait_max_height">96dp</dimen>
    <dimen name="dashboard_hero_ribbon_portrait_shift_y">10dp</dimen>

    <!-- Measurement ceiling for the ribbon backdrop, not a display height. The
         nodpi bitmap measures at 900 x 400dp and would stretch the card on the
         first pass. ImageView honours maxHeight only while a dimension is
         unresolved, so the second pass ignores this and the ribbon fills the
         card. Any value under the card's ~216dp content height works. -->
    <dimen name="dashboard_hero_backdrop_measure_cap">40dp</dimen>

    <!-- Ribbon opacity. Dark line work has to sit well back on the light
         surface; values-night runs it at full strength. -->
    <item name="dashboard_hero_ribbon_alpha" format="float" type="dimen">0.3</item>

