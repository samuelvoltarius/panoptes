    <string name="einr_updates_auto">Automatisch</string>
    <string name="einr_updates_auto_satz">Alleen als de auto geparkeerd en uit is.</string>
    <string name="einr_extra_telegram_titel">Telegram</string>
    <string name="einr_extra_telegram_text">Berichten van de Bewaker en de auto naar je telefoon, via je eigen Telegram-bot.</string>
    <string name="einr_extra_planer_titel">Routeplanner koppelen</string>
    <string name="einr_extra_planer_text">Dan zie je onderweg of de accu tot je bestemming genoeg is. Koppelen gaat met een code op je telefoon.</string>
    <string name="einr_extra_cockpit_titel">EV Cockpit koppelen</string>
    <string name="einr_extra_cockpit_text">De EV Cockpit op je pc toont de waarden van je auto. Koppelen kost één tik.</string>
    <string name="einr_extra_fernzugang_titel">Toegang op afstand (Tailscale)</string>
    <string name="einr_extra_fernzugang_text">Alleen nodig als je vanaf elders in de auto wilt kijken. Daarvoor heb je een gratis Tailscale-account nodig.</string>
    <string name="einr_fertig_titel">Draait alles?</string>
    <string name="einr_fertig_pruefe">Panoptes controleert …</string>
    <string name="einr_ungeprueft">Nog niet gecontroleerd.</string>
