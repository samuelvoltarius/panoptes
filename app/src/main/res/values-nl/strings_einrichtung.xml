    <string name="einr_updates_pruefen_ja">Panoptes controleert regelmatig of er een nieuwe versie is.</string>
    <string name="einr_updates_pruefen_nein">Je zoekt zelf onder Systeem → App-updates.</string>
    <string name="einr_updates_frage_mobil">Ook downloaden via mobiel internet? Dat kost databundel.</string>
    <string name="einr_updates_mobil_ja">Updates komen ook onderweg binnen.</string>
    <string name="einr_updates_mobil_nein">Alleen via wifi.</string>
    <string name="einr_updates_frage_modus">Hoe moeten updates worden geïnstalleerd?</string>
