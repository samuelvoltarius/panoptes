<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nur Loopback-HTTP zum Panoptes-Kern (Launcher-Schnittstelle und 3D-Fahrzeugseite). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 0.1.39 (L1): Rückfall-Statusleiste über einer nicht teilbaren Navi-App; nur nach Zustimmung in den Android-Einstellungen -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Nur für die Statusleiste: WLAN an/aus und Bluetooth an/aus anzeigen (keine Verbindungen, kein Scan). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <queries>
        <package android:name="at.greenchili.surfmate" />
        <!-- Nur lesen: welcher Startbildschirm (BYD) ist da, damit der Knopf dorthin zurückführt. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- App-Schublade: alle startbaren Apps wie in jedem Launcher. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_panoptes"
        android:roundIcon="@mipmap/ic_panoptes"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PanoptesLauncher"
        android:usesCleartextTraffic="true">
        <!--
            HOME gibt es NUR im deaktivierten Alias .HomeAlias (0.1.38.7, LAUNCHER_SPEC §1). MainActivity hat nie
            HOME. Ohne den bewussten Schalter in Panoptes bleibt der Alias aus: Die App startet wie jede normale
            App und kann nicht Standard-Home werden. Der Daemon schaltet ihn ein (pm enable) und im Notfall wieder
            aus (pm disable) - dann nimmt Android von selbst den BYD-Startbildschirm. Der BYD-Launcher wird nie angetastet.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="uiMode|orientation|screenSize|smallestScreenSize|screenLayout|density|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".HomeAlias"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
        <!-- Medien-Session und Benachrichtigungspunkt; nur aktiv, wenn der Nutzer den Zugriff selbst erlaubt. -->
        <service
            android:name=".MedienDienst"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- 0.1.44 (P1): Bedienungshilfe für „Zurück“ / „Letzte App“; nur aktiv, wenn der Nutzer sie selbst einschaltet. -->
        <service
            android:name=".PanoptesBedienhilfe"
            android:exported="true"
            android:label="@string/hilfe_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/bedienhilfe" />
        </service>
        <!-- 0.1.44 (P1): geführte Einrichtung „als Startbildschirm“ mit Selbsttest (nicht von außen startbar). -->
        <activity
            android:name=".EinrichtungActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ZurueckTestActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
